# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Bases de datos generadas (regenerables con `seed`)
*.db
data/

# Salidas generadas
salidas/

# Scratch de orquestación (subagent-driven-development)
.superpowers/

# Frontend web
web/node_modules/
web/dist/

# Excel fuente confidencial en la raíz (libro de precios/costos internos): NO versionar.
# Se usa localmente como fuente de 'seed'; el catálogo vive en la base de datos.
/*.xlsx

# Secretos / entorno
.env
.env.*
!.env.example

# Node en la raíz: NO va aquí (el frontend vive en web/). Evita arrastres accidentales.
node_modules/
/package.json
/package-lock.json

# Config local de servidores MCP
.mcp.json

# Archivos de trabajo del usuario en ejemplos (plantillas y locks de Excel)
ejemplos/plantilla*.xlsx
ejemplos/~$*.xlsx

# Vault de Obsidian: estado de UI local (cambia en cada sesión), no se versiona.
# El resto de constructor-apus/.obsidian/ (plugins, apariencia, grafo) sí se versiona.
constructor-apus/.obsidian/workspace.json
constructor-apus/.obsidian/workspace-mobile.json

# Scratch de subagent-driven-development (briefs, reportes, diffs de review, ledger).
# Es andamiaje de la sesión de trabajo, no del producto; nunca se versiona.
.superpowers/
